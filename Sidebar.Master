<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Sidebar.master.cs" Inherits="Medicube.Sidebar" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="sidebar.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
            <div class="wrapper">
                    <!-- Main Content -->
                    <div class="main-content">
                       
                    </div>


                    <!-- Sidebar -->
                    <div class="sidebar" id="sidebar">
                        <div class="sidebar-header p-3">
                            <div class="d-flex align-items-center justify-content-between">
                                <h5 class="mb-0">MEDICUBE SYSTEM</h5>

                            </div>
                        </div>


                        <!-- Navigation -->
                        <nav class="nav flex-column mt-2">
                            <a href="#" class="nav-link active">
                                <i class="bi bi-house me-2"></i>Dashboard
                            </a>
                             <!-- MEDICINE MENU -->
                            <a class="nav-link d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#medicineMenu"
                               role="button"
                               aria-expanded="false">

                                <span>
                                    <i class="bi bi-capsule me-2"></i> Medicine
                                </span>
                                <i class="bi bi-chevron-down"></i>
                            </a>

                            <div class="collapse submenu" id="medicineMenu">
                                <a href="AddMedicine.aspx" class="nav-link">
                                    <i class="bi bi-plus-circle me-2"></i> Add Medicine
                                </a>

                                <a href="ViewMedicine.aspx" class="nav-link">
                                    <i class="bi bi-list-ul me-2"></i> View Medicines
                                </a>
                            </div>
                            <a href="Category.aspx" class="nav-link">                  
                                <i class="bi bi-tags me-2"></i>Categories         
                            </a>
                           
                            <a class="nav-link d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#supplierMenu"
                               role="button"
                               aria-expanded="false">

                                <span>
                                    <i class="bi bi-building me-2"></i> Supplier
                                </span>
                                <i class="bi bi-chevron-down"></i>
                            </a>

                            <div class="collapse submenu" id="supplierMenu">
                                <a href="AddSupplier.aspx" class="nav-link">
                                    <i class="bi bi-plus-circle me-2"></i> Add Supplier
                                </a>

                                <a href="ViewSuppliers.aspx" class="nav-link">
                                    <i class="bi bi-list-ul me-2"></i> View Supplier
                                </a>
                                 <a href="SupplierPayment.aspx" class="nav-link">
                                     <i class="bi bi-list-ul me-2"></i> Supplier Payment
                                 </a>
                                 <a href="PaymentHistory.aspx" class="nav-link">
                                     <i class="bi bi-list-ul me-2"></i> Payment History
                                 </a>
                            </div>
      
                            <a class="nav-link d-flex justify-content-between align-items-center"
                                data-bs-toggle="collapse"
                                href="#stockMenu"
                                role="button"
                                aria-expanded="false">

                                 <span>
                                     <i class="bi bi-calendar-x me-2"></i> Stock
                                 </span>
                                 <i class="bi bi-chevron-down"></i>
                             </a>

                             <div class="collapse submenu" id="stockMenu">
                                 <a href="Stock.aspx" class="nav-link">
                                     <i class="bi bi-plus-circle me-2"></i> Stock overview
                                 </a>

                                 <a href="StockIn.aspx" class="nav-link">
                                     <i class="bi bi-list-ul me-2"></i> Stock in
                                 </a>
                                  <a href="StockOut.aspx" class="nav-link">
                                     <i class="bi bi-list-ul me-2"></i> Stock out
                                 </a>
                             </div>
                            <a href="#" class="nav-link">
                                <i class="bi bi-bar-chart-line me-2"></i> Reports
                            </a>
                            <a href="#" class="nav-link">
                                <i class="bi bi-person me-2"></i>Users
                            </a>
                            <a href="#" class="nav-link">
                                <i class="bi bi-chat me-2"></i>Messages
                            </a>
                            <a href="#" class="nav-link">
                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                            </a>
                        </nav>

                    </div>


                </div>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
